{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "document_id",
    "pass",
    "criteria"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "pass": {
      "const": "REALISM"
    },
    "criteria": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "decision",
          "reason_code",
          "justification",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "FAIL",
              "PASS",
              "UNCERTAIN"
            ]
          },
          "reason_code": {
            "type": "string"
          },
          "justification": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment_id",
                "quote"
              ],
              "properties": {
                "segment_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
